# ============ 模型配置（二选一） ============

# 方案 A：OpenAI 官方（走默认的 Responses API，支持流式）
#OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
#ACCOUNTING_LLM_MODEL=gpt-4.1-mini

# 方案 B：任何 OpenAI 兼容端点（填了 BASE_URL 就自动切到 chat/completions，国内最省事）
# 通义千问 DashScope：
#ACCOUNTING_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#ACCOUNTING_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#ACCOUNTING_LLM_MODEL=qwen-plus
#
# DeepSeek：
#ACCOUNTING_LLM_BASE_URL=https://api.deepseek.com/v1
#ACCOUNTING_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#ACCOUNTING_LLM_MODEL=deepseek-chat

# ============ 可选 ============
# 数据库文件位置（默认 ./data/accounting.db）
#ACCOUNTING_DB=E:\project-try\accounting-ai\data\accounting.db
# 监听地址与端口（默认 127.0.0.1:8000）
#ACCOUNTING_HOST=0.0.0.0
#ACCOUNTING_PORT=8000
# 设为 1 才会把 trace 上报到 OpenAI（用第三方模型时别开）
#ACCOUNTING_LLM_TRACING=0

